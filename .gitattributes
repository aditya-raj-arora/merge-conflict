# =========================================================
# .gitattributes — the "identification rulebook" for the repo (CI: Configuration Identification)
# Declares merge strategy, line endings, and diff/LFS filters per file type
# so Git treats each Computer Software Unit (CSU) the way its type demands.
# =========================================================
# Default: normalize line endings to LF in the repo, checkout native
* text=auto eol=lf
# --- Source (TLCSC-01..04) — always LF, always diffable as text ---
*.ts text eol=lf diff=typescript
*.tsx text eol=lf diff=typescript
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# --- CHANGELOG.md keeps its own history shape on merge conflicts ---
# (Keep a Changelog convention: prefer local/incoming block over a 3-way text merge)
CHANGELOG.md merge=ours
# --- Binary assets — never diffed as text, routed through Git LFS ---
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
# --- Everything else binary-ish, just in case ---
*.ico binary
